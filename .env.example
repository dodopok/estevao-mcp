# ─── Upstream Estêvão API ────────────────────────────────────────────────────
ESTEVAO_BASE_URL=https://api.caminhoanglicano.com.br
ESTEVAO_DEFAULT_PRAYER_BOOK=loc_2015
# ESTEVAO_TIMEZONE=America/Sao_Paulo
# ESTEVAO_LANGUAGE=pt-BR

# ─── stdio / single-key mode ─────────────────────────────────────────────────
# Required for `npm run dev` (stdio). Leave unset on a multi-tenant HTTP deployment.
# ESTEVAO_API_KEY=estevao_...
# ESTEVAO_MCP_TOKEN=shared-secret-for-single-key-http-mode

# ─── Remote transport ────────────────────────────────────────────────────────
PORT=3333
# ESTEVAO_MCP_ALLOWED_HOSTS=mcp.caminhoanglicano.com.br
# Set to false to require OAuth and reject raw X-API-Key credentials.
# ESTEVAO_MCP_ALLOW_API_KEY_HEADER=true

# ─── OAuth 2.1 (all five required together, or none) ─────────────────────────
MCP_PUBLIC_URL=https://mcp.caminhoanglicano.com.br
# openssl rand -hex 32
MCP_ENCRYPTION_KEY=
# Firebase project of the DEVELOPER PORTAL (not the mobile app)
DEVELOPER_FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=

# Postgres for OAuth state and the encrypted API-key vault (Railway provides this)
DATABASE_URL=
# MCP_DATABASE_SSL=true
# ESTEVAO_PORTAL_URL=https://estevao.caminhoanglicano.com.br
# ESTEVAO_DOCS_URL=https://estevao.caminhoanglicano.com.br/docs/mcp
# MCP_ALLOW_CLIENT_ID_METADATA_DOCUMENTS=true
