{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.dodopok/estevao-mcp",
  "description": "Anglican liturgical calendar, lectionary and Daily Office (Book of Common Prayer) via Estêvão API",
  "repository": {
    "url": "https://github.com/dodopok/estevao-mcp",
    "source": "github"
  },
  "version": "0.1.2",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "estevao-mcp",
      "version": "0.1.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ESTEVAO_API_KEY",
          "description": "Estêvão API key (estevao_ prefix)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
