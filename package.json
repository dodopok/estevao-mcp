{
  "name": "estevao-mcp",
  "version": "0.3.0",
  "description": "MCP server for the Estêvão API — Anglican liturgical calendar, lectionary and Daily Office (Book of Common Prayer / Livro de Oração Comum)",
  "mcpName": "io.github.dodopok/estevao-mcp",
  "type": "module",
  "license": "MIT",
  "bin": {
    "estevao-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "record-fixtures": "tsx scripts/record-fixtures.ts",
    "inspector": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "start:http": "node dist/http.js",
    "dev:http": "tsx src/http.ts",
    "version": "tsx scripts/sync-version.ts && git add server.json"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "anglican",
    "liturgy",
    "lectionary",
    "book-of-common-prayer",
    "daily-office",
    "liturgical-calendar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dodopok/estevao-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^5.2.1",
    "jose": "^6.2.10",
    "lru-cache": "^11.0.0",
    "pg": "^8.23.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "msw": "^2.7.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
